---
import AiKeyForm from "@/components/account/AiKeyForm";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { getMaskedAiProviderKey, isAiProviderKeyEncryptionAvailable } from "@/lib/ai-provider-keys";
import { consumeToastStatus, getToastNotification } from "@/lib/toast-notifications";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const credentialResult = await getMaskedAiProviderKey(supabase, user.id);
const credential = credentialResult.ok ? credentialResult.data : null;
const encryptionAvailable = isAiProviderKeyEncryptionAvailable();
const accountEmail = user.email?.trim() || "Email unavailable";

const toastStatus = consumeToastStatus(Astro.cookies);
const accountStatuses = new Set(["saved", "removed", "invalid", "rejected", "retry", "unavailable", "error"]);
const notification = toastStatus && accountStatuses.has(toastStatus) ? getToastNotification(toastStatus) : null;
---

<AuthenticatedLayout title="Account | Perfect Training Planner" notification={notification}>
  <div>
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Account Settings</h1>
    </div>

    {
      !credentialResult.ok && (
        <p role="alert" class="mb-4 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
          Credential settings could not be loaded. Please refresh and try again.
        </p>
      )
    }

    {
      !encryptionAvailable && (
        <p
          role="status"
          class="mb-4 rounded-xl border border-amber-300/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100"
        >
          Saving or replacing a key is temporarily unavailable because server-side encryption is not configured.
          Removing an existing key remains available.
        </p>
      )
    }

    <section class="mb-6 rounded-2xl border border-white/10 bg-white/5 p-5 sm:p-7">
      <h2 class="text-lg font-semibold text-white">Email address</h2>
      <p class="mt-2 text-sm leading-6 break-words text-blue-100/65">{accountEmail}</p>
    </section>

    <section
      class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-7"
    >
      <AiKeyForm
        configured={credential !== null}
        provider={credential?.provider ?? "openrouter"}
        updatedAt={credential?.updatedAt}
        encryptionAvailable={encryptionAvailable}
        client:load
      />
    </section>

    <section class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-5 sm:p-7">
      <div class="flex flex-col gap-4 min-[540px]:flex-row min-[540px]:items-center min-[540px]:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-white">Sign out</h2>
          <p class="mt-2 text-sm leading-6 text-blue-100/65">End this browser session on this device.</p>
        </div>
        <form method="POST" action="/api/auth/signout" class="shrink-0">
          <button
            type="submit"
            class="inline-flex min-h-10 items-center justify-center rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-blue-50 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300"
          >
            Sign out
          </button>
        </form>
      </div>
    </section>
  </div>
</AuthenticatedLayout>
