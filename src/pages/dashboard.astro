---
import PlannedWorkoutSummary from "@/components/workouts/PlannedWorkoutSummary.tsx";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { loadCurrentPlannedWorkout } from "@/lib/planned-workouts";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const planResult = await loadCurrentPlannedWorkout(supabase, user.id);
const currentPlan = planResult.ok ? planResult.data : null;
const showSavedStatus = Astro.url.searchParams.get("status") === "workout-saved" && currentPlan !== null;
const showAiSavedStatus = Astro.url.searchParams.get("status") === "ai-workout-saved" && currentPlan?.origin === "ai";
const showUpdatedStatus = Astro.url.searchParams.get("status") === "workout-updated" && currentPlan !== null;
const showDeletedStatus = Astro.url.searchParams.get("status") === "workout-deleted" && currentPlan === null;
const showChangedStatus = Astro.url.searchParams.get("status") === "workout-changed";
const showCompletedStatus =
  Astro.url.searchParams.get("status") === "workout-completed" && planResult.ok && currentPlan === null;
const showAccountCreatedStatus = Astro.url.searchParams.get("status") === "account-created";
---

<AuthenticatedLayout title="Dashboard | Perfect Training Planner">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Dashboard</h1>
  </div>

  {
    showAccountCreatedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your account was created successfully.
      </p>
    )
  }
  {
    showSavedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your manual workout was saved successfully.
      </p>
    )
  }
  {
    showAiSavedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your AI-generated workout was saved successfully. You can still edit every exercise and prescription.
      </p>
    )
  }
  {
    showUpdatedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your planned workout was updated successfully.
      </p>
    )
  }
  {
    showDeletedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your planned workout was deleted.
      </p>
    )
  }
  {
    showCompletedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your workout was marked done and moved to completed history.
      </p>
    )
  }
  {
    showChangedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-amber-300/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100"
      >
        Your planned workout changed elsewhere. The latest saved state is shown below.
      </p>
    )
  }

  {
    !planResult.ok ? (
      <section class="rounded-2xl border border-red-400/30 bg-red-500/10 p-5 text-red-100 sm:p-7">
        <h2 class="text-lg font-semibold">Your planned workout could not be loaded</h2>
        <p class="mt-2 text-sm leading-6 text-red-100/80">
          Refresh the page to try again. No workout data was changed.
        </p>
      </section>
    ) : currentPlan ? (
      <PlannedWorkoutSummary plan={currentPlan} client:load />
    ) : (
      <section class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-white">No planned workout yet</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-blue-100/65 sm:text-base">
          Generate a balanced starter with AI or choose exercises yourself to create an ordered sets-and-reps plan.
        </p>
      </section>
    )
  }
</AuthenticatedLayout>
