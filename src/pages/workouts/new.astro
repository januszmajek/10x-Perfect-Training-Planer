---
import WorkoutBuilder from "@/components/workouts/WorkoutBuilder.tsx";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { getMaskedAiProviderKey } from "@/lib/ai-provider-keys";
import { loadAiExercisePreferences } from "@/lib/history-aware-ai-profile";
import { loadWorkoutBuilderData } from "@/lib/manual-workouts";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const [builderResult, credentialResult, preferencesResult] = await Promise.all([
  loadWorkoutBuilderData(supabase, user.id),
  getMaskedAiProviderKey(supabase, user.id),
  loadAiExercisePreferences(supabase, user.id),
]);
---

<AuthenticatedLayout title="Workout builder | Perfect Training Planner">
  <div class="mb-8">
    <p class="text-sm font-medium tracking-wide text-purple-300 uppercase">Workout planning</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Workout builder</h1>
  </div>

  {
    builderResult.ok ? (
      <WorkoutBuilder
        catalogue={builderResult.data.catalogue}
        initialCurrentPlan={builderResult.data.currentPlan}
        credentialConfigured={credentialResult.ok && credentialResult.data !== null}
        initialPreferences={preferencesResult.ok ? Object.fromEntries(preferencesResult.data) : null}
        client:load
      />
    ) : (
      <section class="rounded-2xl border border-red-400/30 bg-red-500/10 p-5 text-red-100 sm:p-7">
        <h2 class="text-lg font-semibold">The workout builder could not be loaded</h2>
        <p class="mt-2 text-sm leading-6 text-red-100/80">
          Your existing plan was not changed. Refresh the page to try again or return to the dashboard.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a
            href="/workouts/new"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-red-100 px-4 py-2 text-sm font-semibold text-red-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-100"
          >
            Try again
          </a>
          <a
            href="/dashboard"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-red-100/25 px-4 py-2 text-sm font-semibold text-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-100"
          >
            Return to dashboard
          </a>
        </div>
      </section>
    )
  }
</AuthenticatedLayout>
