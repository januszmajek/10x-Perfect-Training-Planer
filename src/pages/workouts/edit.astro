---
import PlannedWorkoutEditor from "@/components/workouts/PlannedWorkoutEditor.tsx";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { loadWorkoutBuilderData } from "@/lib/manual-workouts";
import { parseWorkoutCatalogueNavigation, toWorkoutCatalogueNavigationUrl } from "@/lib/workout-catalogue-navigation";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const editorResult = await loadWorkoutBuilderData(supabase, user.id);

if (editorResult.ok && editorResult.data.currentPlan === null) {
  return Astro.redirect("/dashboard");
}

const editorData =
  editorResult.ok && editorResult.data.currentPlan
    ? {
        catalogue: editorResult.data.catalogue,
        plan: editorResult.data.currentPlan,
      }
    : null;

const initialCatalogueNavigation = editorData
  ? parseWorkoutCatalogueNavigation(Astro.url.searchParams, editorData.catalogue)
  : null;

if (editorData && initialCatalogueNavigation) {
  const canonicalUrl = toWorkoutCatalogueNavigationUrl(
    Astro.url.pathname,
    Astro.url.searchParams,
    initialCatalogueNavigation,
    editorData.catalogue,
  );
  if (`${Astro.url.pathname}${Astro.url.search}` !== canonicalUrl) return Astro.redirect(canonicalUrl, 302);
}
---

<AuthenticatedLayout title="Edit planned workout | Perfect Training Planner">
  <div class="mb-8">
    <p class="text-sm font-medium tracking-wide text-purple-300 uppercase">Planned workout</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Edit your workout</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/65 sm:text-base">
      Update your exercise order and prescriptions. Changes are saved only when you choose Save changes.
    </p>
  </div>

  {
    editorData ? (
      <PlannedWorkoutEditor
        catalogue={editorData.catalogue}
        initialPlan={editorData.plan}
        initialCatalogueNavigation={initialCatalogueNavigation!}
        client:load
      />
    ) : (
      <section class="rounded-2xl border border-red-400/30 bg-red-500/10 p-5 text-red-100 sm:p-7">
        <h2 class="text-lg font-semibold">Your planned workout could not be loaded</h2>
        <p class="mt-2 text-sm leading-6 text-red-100/80">
          No workout data was changed. Retry loading the editor or return to your dashboard.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a
            href="/workouts/edit"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-red-100 px-4 py-2 text-sm font-semibold text-red-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-100"
          >
            Try again
          </a>
          <a
            href="/dashboard"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-red-100/25 px-4 py-2 text-sm font-semibold text-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-100"
          >
            Return to dashboard
          </a>
        </div>
      </section>
    )
  }
</AuthenticatedLayout>
