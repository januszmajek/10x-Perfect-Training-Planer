---
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
}

const { title = "Perfect Training Planner" } = Astro.props;
---

<Layout title={title}>
  <slot />
</Layout>

<script>
  function reloadForRestoredHistory() {
    window.location.reload();
  }

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) reloadForRestoredHistory();
  });

  window.addEventListener("popstate", reloadForRestoredHistory);
</script>
