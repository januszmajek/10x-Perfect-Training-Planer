---
import Layout from "@/layouts/Layout.astro";
import MobileNavigation from "@/components/MobileNavigation";
import SidebarNavigation from "@/components/SidebarNavigation";

interface Props {
  title?: string;
}

const { title = "Perfect Training Planner" } = Astro.props;
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const navigation = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/workouts/new", label: "Workout" },
  { href: "/history", label: "History" },
];
---

<Layout title={title}>
  <div class="bg-cosmic min-h-screen text-white sm:flex">
    <header class="border-b border-white/10 bg-slate-950/60 backdrop-blur-xl sm:hidden">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <div class="mr-auto flex items-center gap-3">
          <MobileNavigation currentPath={Astro.url.pathname} navigation={navigation} client:load />
          <a
            href="/dashboard"
            class="inline-flex rounded-sm text-xl font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-300"
          >
            Perfect Training Planner
          </a>
        </div>
      </div>
    </header>

    <SidebarNavigation currentPath={Astro.url.pathname} />

    <main class="mx-auto w-full max-w-5xl px-4 py-8 sm:py-12">
      <slot />
    </main>
  </div>
</Layout>

<script>
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) window.location.reload();
  });
</script>
