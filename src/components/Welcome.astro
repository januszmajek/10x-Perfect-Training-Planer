<div class="min-h-screen overflow-hidden bg-[#080d1c] text-white">
  <!-- Background decoration -->
  <div class="pointer-events-none fixed inset-0">
    <div class="absolute -top-40 left-1/2 h-150 w-200 -translate-x-1/2 rounded-full bg-purple-700/15 blur-[180px]">
    </div>

    <div class="absolute top-225 -left-60 h-125 w-125 rounded-full bg-violet-700/10 blur-[160px]"></div>
  </div>

  <div class="relative z-10">
    <!-- HERO -->
    <section
      class="mx-auto grid min-h-205 max-w-360 items-center gap-16 px-6 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:px-10"
    >
      <div class="min-w-0">
        <h1 class="text-[clamp(2.5rem,4.5vw,4.5rem)] leading-[0.97] font-bold tracking-tighter">
          <span class="block whitespace-nowrap">
            Train with
            <span class="bg-linear-to-r from-purple-300 via-violet-400 to-fuchsia-400 bg-clip-text text-transparent">
              a plan.
            </span>
          </span>

          <span class="mt-2 block whitespace-nowrap"> Not a guess. </span>
        </h1>

        <p class="mt-8 max-w-lg text-lg leading-8 text-slate-400">
          Generate balanced workouts with AI, build your own routines and keep your training history in one simple
          place.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/auth/signup"
            class="inline-flex items-center gap-3 rounded-xl bg-purple-600 px-6 py-3.5 font-semibold shadow-lg shadow-purple-900/30 transition hover:bg-purple-500"
          >
            Start planning

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Screenshot stack -->
      <div class="relative mx-auto w-full max-w-190 lg:translate-x-8">
        <div class="absolute inset-10 rounded-full bg-purple-600/20 blur-[100px]"></div>

        <div
          class="relative translate-x-12 rotate-[4deg] overflow-hidden rounded-2xl border border-white/10 bg-[#111728] shadow-2xl shadow-black/50"
        >
          <img src="/landing/history.png" alt="Workout history" class="w-full" />
        </div>

        <div
          class="absolute top-12 -left-8 w-[92%] rotate-[-5deg] overflow-hidden rounded-2xl border border-white/10 bg-[#111728] shadow-2xl shadow-black/70"
        >
          <img src="/landing/workout-builder.png" alt="Workout builder" class="w-full" />
        </div>

        <div
          class="absolute top-24 left-6 w-[94%] rotate-[0.5deg] overflow-hidden rounded-2xl border border-purple-400/20 bg-[#111728] shadow-2xl shadow-black/70"
        >
          <img src="/landing/dashboard.png" alt="Perfect Training Planner dashboard" class="w-full" />
        </div>
      </div>
    </section>

    <!-- PRODUCT NUMBERS -->
    <section class="mx-auto max-w-330 px-6 py-16 lg:px-0">
      <div
        class="grid divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-[#0d1324]/80 shadow-xl shadow-black/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      >
        <div class="px-8 py-10 sm:px-10">
          <p class="mb-3 text-lg text-purple-400">Exercises available</p>

          <p class="text-5xl font-bold tracking-tight">50+</p>
        </div>

        <div class="px-8 py-10 sm:px-10">
          <p class="mb-3 text-lg text-purple-400">Workout creation</p>

          <p class="text-5xl font-bold tracking-tight">
            AI
            <span class="text-purple-400">+</span>
            Manual
          </p>
        </div>

        <div class="px-8 py-10 sm:px-10">
          <p class="mb-3 text-lg text-purple-400">Training history</p>

          <p class="text-5xl font-bold tracking-tight">Always yours.</p>
        </div>
      </div>
    </section>

    <!-- WORKOUT BUILDER -->
    <section class="mx-auto grid max-w-330 items-center gap-16 px-6 py-32 lg:grid-cols-2 lg:px-0 lg:py-40">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-wide text-purple-400">BUILD YOUR WORKOUT</p>

        <h2 class="max-w-lg text-4xl leading-tight font-bold tracking-[-0.04em] sm:text-5xl">
          Your workout.
          <br />
          Your rules.
        </h2>

        <p class="mt-7 max-w-md text-lg leading-8 text-slate-400">
          Search exercises, filter by muscles and equipment, choose the order and create exactly the workout you want.
        </p>

        <div class="mt-10 space-y-5">
          {
            [
              "Filter exercises by muscles and equipment",
              "Create your own exercise order",
              "Adjust sets and repetitions before saving",
            ].map((item) => (
              <div class="flex items-center gap-4">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-purple-500/15 text-purple-300">
                  ✓
                </div>

                <span class="text-slate-300">{item}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-10 rounded-full bg-purple-700/15 blur-[100px]"></div>

        <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50">
          <img src="/landing/workout-builder.png" alt="Workout builder interface" class="w-full" />
        </div>
      </div>
    </section>

    <!-- AI -->
    <section class="bg-linear-to-b from-transparent via-white/[0.015] to-transparent">
      <div class="mx-auto grid max-w-330 items-center gap-16 px-6 py-32 lg:grid-cols-2 lg:px-0 lg:py-40">
        <div class="relative max-sm:order-2 lg:order-1">
          <div class="absolute inset-10 rounded-full bg-violet-600/15 blur-[100px]"></div>

          <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50">
            <img src="/landing/dashboard.png" alt="Generated workout dashboard" class="w-full" />
          </div>
        </div>

        <div class="max-sm:order-1 lg:order-2 lg:pl-16">
          <p class="mb-5 text-sm font-semibold tracking-wide text-purple-400">AI WORKOUTS</p>

          <h2 class="text-4xl leading-tight font-bold tracking-[-0.04em] sm:text-5xl">
            Let AI do
            <br />
            the planning.
          </h2>

          <p class="mt-7 max-w-md text-lg leading-8 text-slate-400">
            Generate a balanced full-body workout from the exercise catalog, then change anything you want before saving
            it.
          </p>
        </div>
      </div>
    </section>

    <!-- HISTORY -->
    <section class="mx-auto grid max-w-330 items-center gap-16 px-6 py-32 lg:grid-cols-2 lg:px-0 lg:py-40">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-wide text-purple-400">TRAINING HISTORY</p>

        <h2 class="text-4xl leading-tight font-bold tracking-[-0.04em] sm:text-5xl">
          Every workout.
          <br />
          Kept in one place.
        </h2>

        <p class="mt-7 max-w-md text-lg leading-8 text-slate-400">
          Complete a workout and it automatically becomes part of your history. Find previous sessions by date, muscles
          or equipment.
        </p>
      </div>

      <div class="relative">
        <div class="absolute inset-10 rounded-full bg-purple-700/15 blur-[100px]"></div>

        <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50">
          <img src="/landing/history.png" alt="Workout history" class="w-full" />
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="bg-linear-to-b from-transparent via-[#090f20] to-transparent">
      <div class="mx-auto max-w-330 px-6 py-32 lg:px-0">
        <div class="mb-16 max-w-2xl">
          <h2 class="text-4xl font-bold tracking-[-0.04em] sm:text-5xl">
            Less setup.
            <br />
            More training.
          </h2>

          <p class="mt-6 text-lg text-slate-400">Everything needed to go from an empty plan to a finished workout.</p>
        </div>

        <div
          class="grid divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-[#0d1324]/80 shadow-xl shadow-black/10 md:grid-cols-3 md:divide-x md:divide-y-0"
        >
          {
            [
              {
                number: "1",
                title: "Generate",
                description: "Create a balanced workout automatically using AI.",
              },
              {
                number: "2",
                title: "Customize",
                description: "Change exercises, their order, sets and repetitions.",
              },
              {
                number: "3",
                title: "Complete",
                description: "Finish the session and keep it permanently in your history.",
              },
            ].map((feature) => (
              <div class="px-8 py-10 sm:px-10">
                <h3 class="mt-1 text-2xl font-semibold">{feature.title}</h3>

                <p class="mt-4 text-2xl leading-7 text-slate-400">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section
      class="mx-auto grid min-h-155 max-w-360 items-center gap-16 px-6 py-32 lg:grid-cols-[1.15fr_0.85fr] lg:px-10"
    >
      <div class="min-w-0">
        <h2 class="text-[clamp(2.5rem,4.5vw,4.5rem)] leading-[0.97] font-bold tracking-tighter sm:whitespace-nowrap">
          Your next workout
          <span class="bg-linear-to-r from-purple-300 via-violet-400 to-fuchsia-400 bg-clip-text text-transparent">
            starts here.
          </span>
        </h2>

        <p class="mt-8 max-w-lg text-lg leading-8 text-slate-400">
          Stop figuring out what to train next. Build it yourself or let AI create the starting point.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/auth/signup"
            class="inline-flex items-center gap-3 rounded-xl bg-purple-600 px-6 py-3.5 font-semibold shadow-lg shadow-purple-900/30 transition hover:bg-purple-500"
          >
            Create your workout

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</div>
